rules_version = '2';

// One document per reader, at users/{uid}, holding their saved articles and
// settings — see RemoteSyncClient.android.kt. A reader can only ever read or
// write their own document; nothing here is queryable across readers, so
// there is no broader rule needed than this one line.
//
// Deploy from the Firebase console: Firestore Database -> Rules -> paste this
// file's contents -> Publish. Or via the CLI: `firebase deploy --only firestore:rules`
// (needs a firebase.json pointing at this file, which this repo does not keep
// since nothing else here uses the Firebase CLI).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // email_verified is redundant today and deliberately kept anyway: both
      // sign-in methods prove the address by construction — Google vouches for
      // its own accounts, and a sign-in link cannot be followed by someone who
      // cannot read the inbox — so nothing legitimate is turned away. What it
      // buys is that adding a provider which does not prove ownership, such as
      // plain email and password, cannot silently reach anyone's data.
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email_verified == true;
    }
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The whole app is a single ComposeUIViewController, so there is no
	     controller to override preferredStatusBarStyle on per screen. The
	     Kotlin side sets the style on UIApplication instead. -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- The build settings declare portrait as the only supported orientation.
	     On iPad that is only allowed for an app that opts out of multitasking,
	     otherwise the App Store upload warns that a multitasking app must
	     support all four. Newer iPadOS ignores the key and resizes anyway; it
	     costs nothing there and keeps the validation clean everywhere else. -->
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>

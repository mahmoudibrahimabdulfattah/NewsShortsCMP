<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The whole app is a single ComposeUIViewController, so there is no
	     controller to override preferredStatusBarStyle on per screen. The
	     Kotlin side sets the style on UIApplication instead. -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
